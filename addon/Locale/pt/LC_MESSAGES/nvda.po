#: addon\globalPlugins\freeradio\__init__.py:780
#: addon\globalPlugins\freeradio\__init__.py:790
msgid "FreeRadio"
msgstr "FreeRadio"

#. Translators: Spoken when no audio output devices could be found on the system at all.
#. Translators: Spoken when no output devices are found while setting up audio mirroring.
#: addon\globalPlugins\freeradio\audioDeviceMixin.py:57
#: addon\globalPlugins\freeradio\audioDeviceMixin.py:191
msgid "No audio output devices found"
msgstr "Nenhum dispositivo de saída de áudio encontrado"

#. Translators: Spoken instead of showing a picker, when only one physical audio output device exists.
#: addon\globalPlugins\freeradio\audioDeviceMixin.py:63
msgid ""
"Only one physical audio output device is available. FreeRadio uses the "
"system default output."
msgstr ""
"Apenas um dispositivo físico de saída de áudio está disponível. O FreeRadio "
"utiliza a saída predefinida do sistema."

#. Translators: First entry in the output-device list; means 'use whatever Windows currently has as its default output'.
#. Translators: Same meaning as 'System default' above; label shown when announcing the currently active output device.
#: addon\globalPlugins\freeradio\audioDeviceMixin.py:71
#: addon\globalPlugins\freeradio\audioDeviceMixin.py:159
#: addon\globalPlugins\freeradio\obligatoMixin.py:91
#: addon\globalPlugins\freeradio\radioDialog.py:1229
#: addon\globalPlugins\freeradio\settingsPanel.py:537
msgid "System default"
msgstr "Predefinição do sistema"

#. Translators: Prompt of the dialog listing devices to choose as FreeRadio's main playback output.
#: addon\globalPlugins\freeradio\audioDeviceMixin.py:96
msgid "Select the main output device:"
msgstr "Selecione o dispositivo de saída principal:"

#. Translators: Title of the dialog for choosing FreeRadio's main output device.
#: addon\globalPlugins\freeradio\audioDeviceMixin.py:98
msgid "FreeRadio Output Device"
msgstr "Dispositivo de saída do FreeRadio"

#. Translators: Spoken when switching the main output device fails; %s is the device name.
#: addon\globalPlugins\freeradio\audioDeviceMixin.py:123
#, python-format
msgid "Could not switch to output device: %s"
msgstr "Não foi possível mudar para o dispositivo de saída: %s"

#. Translators: Spoken after successfully switching the main output device; %s is the device name.
#: addon\globalPlugins\freeradio\audioDeviceMixin.py:161
#, python-format
msgid "Output device: %s"
msgstr "Dispositivo de saída: %s"

#. Translators: Name of an NVDA command in the Input Gestures dialog; starts/stops simultaneously playing audio through a second output device.
#: addon\globalPlugins\freeradio\audioDeviceMixin.py:165
msgid "Mirror audio to an additional output device"
msgstr "Espelhar áudio para um dispositivo de saída adicional"

#. Translators: Spoken when audio mirroring to a secondary device is turned off.
#: addon\globalPlugins\freeradio\audioDeviceMixin.py:174
msgid "Audio mirror stopped"
msgstr "Espelhamento de áudio parado"

#. Translators: Spoken if the user tries to start audio mirroring while nothing is playing.
#. Translators: Spoken when this shortcut is pressed while nothing is playing.
#: addon\globalPlugins\freeradio\audioDeviceMixin.py:179
#: addon\globalPlugins\freeradio\recordingMixin.py:106
#: addon\globalPlugins\freeradio\recordingMixin.py:204
#: addon\globalPlugins\freeradio\__init__.py:797
msgid "No station is playing"
msgstr "Não está a ser reproduzida nenhuma estação"

#. Translators: Prompt of the dialog for choosing the secondary (mirror) output device.
#: addon\globalPlugins\freeradio\audioDeviceMixin.py:206
msgid "Select additional output device for audio mirror:"
msgstr ""
"Selecione o dispositivo de saída adicional para o espelhamento de áudio:"

#. Translators: Title of the dialog for choosing the secondary mirror output device.
#: addon\globalPlugins\freeradio\audioDeviceMixin.py:208
msgid "Mirror Audio"
msgstr "Espelhar áudio"

#. Translators: Spoken once mirroring to the chosen secondary device starts successfully; %s is the device name.
#: addon\globalPlugins\freeradio\audioDeviceMixin.py:237
#, python-format
msgid "Mirroring to: %s"
msgstr "A espelhar para: %s"

#. Translators: Spoken when starting the audio mirror to the chosen device fails; %s is the device name.
#: addon\globalPlugins\freeradio\audioDeviceMixin.py:240
#, python-format
msgid "Could not mirror to: %s"
msgstr "Não foi possível espelhar para: %s"

#. Translators: Spoken automatically when the user's selected output device is unplugged; FreeRadio has fallen back to the system default.
#: addon\globalPlugins\freeradio\audioDeviceMixin.py:273
msgid "Audio device disconnected. Switched to system default."
msgstr "Dispositivo de áudio desligado. Mudou para a predefinição do sistema."

#. Translators: Name of an NVDA command; raises FreeRadio's playback volume by 5 (of 200 max, capped at 100 when saved).
#: addon\globalPlugins\freeradio\audioFxMixin.py:33
msgid "Increase FreeRadio volume by 5"
msgstr "Aumentar o volume do FreeRadio em 5"

#. Translators: Spoken after volume is changed with the volume-up/down commands; %d is the new volume level.
#. Translators: Spoken after volume is changed; %d is the new volume level.
#: addon\globalPlugins\freeradio\audioFxMixin.py:42
#: addon\globalPlugins\freeradio\audioFxMixin.py:56
#: addon\globalPlugins\freeradio\radioDialog.py:3298
#: addon\globalPlugins\freeradio\radioDialog.py:3311
#: addon\globalPlugins\freeradio\radioDialog.py:3489
#: addon\globalPlugins\freeradio\radioDialog.py:3496
#, python-format
msgid "Volume %d"
msgstr "Volume %d"

#. Translators: Name of an NVDA command; lowers FreeRadio's playback volume by 5.
#: addon\globalPlugins\freeradio\audioFxMixin.py:47
msgid "Decrease FreeRadio volume by 5"
msgstr "Diminuir o volume do FreeRadio em 5"

#. Translators: Name of an NVDA command; speeds up playback rate, podcasts/audiobooks/GETEM chapters only.
#: addon\globalPlugins\freeradio\audioFxMixin.py:61
msgid "Increase podcast playback speed"
msgstr "Aumentar a velocidade de reprodução do podcast"

#. Translators: Name of an NVDA command; slows down playback rate, podcasts/audiobooks/GETEM chapters only.
#: addon\globalPlugins\freeradio\audioFxMixin.py:70
msgid "Decrease podcast playback speed"
msgstr "Diminuir a velocidade de reprodução do podcast"

#. Translators: Spoken when the playback-rate command returns the rate to normal (1.0x).
#: addon\globalPlugins\freeradio\audioFxMixin.py:81
msgid "Rate normal"
msgstr "Velocidade normal"

#. Translators: Spoken after changing playback rate; %.1f is the new rate, e.g. '1.5' meaning 1.5x speed.
#: addon\globalPlugins\freeradio\audioFxMixin.py:84
#, python-format
msgid "Rate %.1f"
msgstr "Velocidade %.1f"

#. Translators: Spoken when playback-rate change fails because the optional bass_fx library used for time-stretching isn't installed.
#: addon\globalPlugins\freeradio\audioFxMixin.py:88
msgid ""
"Playback speed control needs the bass_fx add-on library — see the FreeRadio "
"docs."
msgstr ""
"O controlo da velocidade de reprodução necessita da biblioteca bass_fx — "
"veja a documentação do FreeRadio."

#. Translators: Spoken when the user tries to change playback rate while playing a live radio station rather than a podcast/audiobook.
#: addon\globalPlugins\freeradio\audioFxMixin.py:91
msgid "Playback speed control is only available for podcasts."
msgstr ""
"O controlo da velocidade de reprodução está disponível apenas para podcasts."

#. Translators: Generic fallback spoken when the playback-rate change fails for an unrecognised reason.
#: addon\globalPlugins\freeradio\audioFxMixin.py:94
msgid "Could not change playback speed."
msgstr "Não foi possível alterar a velocidade de reprodução."

#. Translators: Name of an NVDA command; toggles a low-frequency EQ boost on/off.
#: addon\globalPlugins\freeradio\audioFxMixin.py:132
msgid "Toggle bass boost"
msgstr "Ativar/desativar o reforço de graves"

#. Translators: Short label used in the 'X enabled/disabled' announcement (see _toggle_eq_band) when toggling the bass-boost EQ band.
#: addon\globalPlugins\freeradio\audioFxMixin.py:138
#: addon\globalPlugins\freeradio\radioDialog.py:460
#: addon\globalPlugins\freeradio\settingsPanel.py:142
msgid "EQ: Bass Boost"
msgstr "EQ: Reforço de Graves"

#. Translators: Name of an NVDA command; toggles a high-frequency EQ boost on/off.
#: addon\globalPlugins\freeradio\audioFxMixin.py:142
msgid "Toggle treble boost"
msgstr "Ativar/desativar o reforço de agudos"

#. Translators: Short label used in the 'X enabled/disabled' announcement when toggling the treble-boost EQ band.
#: addon\globalPlugins\freeradio\audioFxMixin.py:148
#: addon\globalPlugins\freeradio\radioDialog.py:460
#: addon\globalPlugins\freeradio\settingsPanel.py:143
msgid "EQ: Treble Boost"
msgstr "EQ: Reforço de Agudos"

#. Translators: Name of an NVDA command; toggles a mid-range EQ boost tuned for vocal clarity on/off.
#: addon\globalPlugins\freeradio\audioFxMixin.py:152
msgid "Toggle vocal boost"
msgstr "Ativar/desativar o reforço vocal"

#. Translators: Short label used in the 'X enabled/disabled' announcement when toggling the vocal-boost EQ band.
#: addon\globalPlugins\freeradio\audioFxMixin.py:158
#: addon\globalPlugins\freeradio\radioDialog.py:460
#: addon\globalPlugins\freeradio\settingsPanel.py:144
msgid "EQ: Vocal Boost"
msgstr "EQ: Reforço Vocal"

#. Translators: Announcement after toggling an EQ band; %(effect)s is one of the 'EQ: ... Boost' labels above, %(state)s is 'enabled'/'disabled' below.
#: addon\globalPlugins\freeradio\audioFxMixin.py:221
#: addon\globalPlugins\freeradio\miscTogglesMixin.py:64
#: addon\globalPlugins\freeradio\miscTogglesMixin.py:104
#: addon\globalPlugins\freeradio\radioDialog.py:1313
#: addon\globalPlugins\freeradio\radioDialog.py:1324
#: addon\globalPlugins\freeradio\radioDialog.py:1348
#: addon\globalPlugins\freeradio\settingsPanel.py:583
#: addon\globalPlugins\freeradio\settingsPanel.py:594
#, python-format
msgid "%(effect)s %(state)s"
msgstr "%(effect)s %(state)s"

#. Translators: Second half of the 'X enabled/disabled' announcement in _toggle_eq_band; describes the EQ band's new on/off state.
#: addon\globalPlugins\freeradio\audioFxMixin.py:224
#: addon\globalPlugins\freeradio\miscTogglesMixin.py:66
#: addon\globalPlugins\freeradio\miscTogglesMixin.py:106
#: addon\globalPlugins\freeradio\radioDialog.py:1315
#: addon\globalPlugins\freeradio\radioDialog.py:1326
#: addon\globalPlugins\freeradio\radioDialog.py:1350
#: addon\globalPlugins\freeradio\settingsPanel.py:585
#: addon\globalPlugins\freeradio\settingsPanel.py:596
#: addon\globalPlugins\freeradio\timeshiftMixin.py:394
msgid "enabled"
msgstr "ativado"

#: addon\globalPlugins\freeradio\audioFxMixin.py:224
#: addon\globalPlugins\freeradio\miscTogglesMixin.py:66
#: addon\globalPlugins\freeradio\miscTogglesMixin.py:106
#: addon\globalPlugins\freeradio\radioDialog.py:1315
#: addon\globalPlugins\freeradio\radioDialog.py:1326
#: addon\globalPlugins\freeradio\radioDialog.py:1350
#: addon\globalPlugins\freeradio\settingsPanel.py:585
#: addon\globalPlugins\freeradio\settingsPanel.py:596
#: addon\globalPlugins\freeradio\timeshiftMixin.py:394
msgid "disabled"
msgstr "desativado"

#. Translators: Name of an NVDA command; cycles the sound effect played when switching stations (crossfade/instant cut/tuning effect).
#: addon\globalPlugins\freeradio\audioFxMixin.py:229
msgid "Toggle station switch transition (crossfade)"
msgstr "Ativar/desativar a transição entre estações (crossfade)"

#. Translators: One of the station-transition modes cycled by the crossfade command: plays no transition sound, cuts instantly.
#: addon\globalPlugins\freeradio\audioFxMixin.py:237
#: addon\globalPlugins\freeradio\settingsPanel.py:179
msgid "Instant cut (no crossfade)"
msgstr "Corte instantâneo (sem crossfade)"

#. Translators: One of the station-transition modes: a brief 1-second audio crossfade between the old and new station.
#: addon\globalPlugins\freeradio\audioFxMixin.py:239
#: addon\globalPlugins\freeradio\settingsPanel.py:180
msgid "Short crossfade (1 second)"
msgstr "Crossfade curto (1 segundo)"

#. Translators: One of the station-transition modes: a longer 2-second audio crossfade between the old and new station.
#: addon\globalPlugins\freeradio\audioFxMixin.py:241
#: addon\globalPlugins\freeradio\settingsPanel.py:181
msgid "Normal crossfade (2 seconds)"
msgstr "Crossfade normal (2 segundos)"

#. Translators: One of the station-transition modes: plays a radio-tuning sound effect instead of a crossfade.
#: addon\globalPlugins\freeradio\audioFxMixin.py:243
#: addon\globalPlugins\freeradio\settingsPanel.py:182
msgid "Station tuning sound effect"
msgstr "Efeito sonoro de sintonia da estação"

#. Translators: Fallback catalog-search result title when GETEM returns no usable link text.
#. Translators: Fallback GetemBook.title when no title was supplied at construction.
#. Translators: Fallback GetemBook.title when the detail page has no parseable title element.
#. Translators: Fallback book title when archive.org returns no title metadata for a search result.
#. Translators: Fallback GutenbergAudiobook.title when no title was supplied at construction.
#: addon\globalPlugins\freeradio\getem.py:430
#: addon\globalPlugins\freeradio\getem.py:460
#: addon\globalPlugins\freeradio\getem.py:1133
#: addon\globalPlugins\freeradio\gutenberg_audiobooks.py:182
#: addon\globalPlugins\freeradio\gutenberg_audiobooks.py:278
#: addon\globalPlugins\freeradio\librivox.py:151
#: addon\globalPlugins\freeradio\librivox.py:246
#: addon\globalPlugins\freeradio\radioDialog.py:3064
#: addon\globalPlugins\freeradio\utils.py:335
msgid "Unknown"
msgstr "Desconhecido"

#. Translators: Fixed source label for GETEM audiobooks, shown in the station-details dialog and the Audio Books tab (same role as gutenberg_audiobooks.py's 'audiobook_source').
#. Reuses the exact same bare "GETEM"/"LibriVox"/"Project Gutenberg"
#. strings RadioDialog._audiobook_source_label_for() already shows
#. next to each book in the Audio Books tab, rather than
#. introducing new, differently-worded translations for the same
#. three names.
#: addon\globalPlugins\freeradio\getem.py:568
#: addon\globalPlugins\freeradio\radioDialog.py:5523
#: addon\globalPlugins\freeradio\settingsPanel.py:420
msgid "GETEM"
msgstr "GETEM"

#. Translators: Error returned by GetemSession.login() when FreeRadio has no saved GETEM credentials at all.
#: addon\globalPlugins\freeradio\getem.py:652
msgid "Please enter your GETEM username and password in FreeRadio's settings."
msgstr ""
"Introduza o seu nome de utilizador e palavra-passe GETEM nas definições do "
"FreeRadio."

#. Translators: Error returned by GetemSession.login() when the GETEM server rejects the saved username/password.
#: addon\globalPlugins\freeradio\getem.py:686
msgid "GETEM login failed. Please check your username and password."
msgstr ""
"Falha no início de sessão GETEM. Verifique o seu nome de utilizador e "
"palavra-passe."

#. Translators: Error returned before attempting login when the settings dialog's GETEM username/password fields are empty.
#: addon\globalPlugins\freeradio\getem.py:720
msgid ""
"Please enter your GETEM username and password in FreeRadio's settings first."
msgstr ""
"Introduza primeiro o seu nome de utilizador e palavra-passe GETEM nas "
"definições do FreeRadio."

#. Translators: Error returned by search_getem() when the user submits an empty search box.
#. Translators: Error returned by search_gutenberg_audiobooks() when the user submits an empty search box.
#: addon\globalPlugins\freeradio\getem.py:756
#: addon\globalPlugins\freeradio\gutenberg_audiobooks.py:223
#: addon\globalPlugins\freeradio\librivox.py:187
#: addon\globalPlugins\freeradio\radioDialog.py:5757
#: addon\globalPlugins\freeradio\radioDialog.py:6704
msgid "Please enter a search term."
msgstr "Introduza um termo de pesquisa."

#. Translators: Error returned by search_getem() when the GETEM catalog page itself could not be fetched (network failure).
#: addon\globalPlugins\freeradio\getem.py:763
msgid "Could not reach GETEM's catalog. Please check your internet connection."
msgstr ""
"Não foi possível aceder ao catálogo do GETEM. Verifique a sua ligação à "
"Internet."

#. Translators: Fallback chapter title for a multi-part work whose parts have no individual names; '{0}' is the book title, '{1}' the 1-based part number.
#: addon\globalPlugins\freeradio\getem.py:886
msgid "{0} - Part {1}"
msgstr "{0} - Parte {1}"

#: addon\globalPlugins\freeradio\getem.py:924
#: addon\globalPlugins\freeradio\getem.py:1151
msgid ""
"No playable audio file was found on this work's GETEM page. It may require "
"manual download from the site."
msgstr ""
"Não foi encontrado nenhum ficheiro de áudio reproduzível na página GETEM "
"desta obra. Pode ser necessário descarregá-lo manualmente do site."

#. Translators: Error returned by get_book_by_url() when the pasted URL doesn't look like a GETEM work page link.
#: addon\globalPlugins\freeradio\getem.py:1115
msgid "This doesn't look like a GETEM work link."
msgstr "Isto não parece ser uma ligação para uma obra do GETEM."

#. Translators: Raised when a chapter download completes but produced a zero-byte file, usually because the GETEM session was not actually logged in.
#: addon\globalPlugins\freeradio\getem.py:1249
msgid "The downloaded file was empty. Please check your GETEM login."
msgstr ""
"O ficheiro descarregado está vazio. Verifique o seu início de sessão GETEM."

#. Translators: Raised when the URL fetched for a chapter returns a response that is not audio at all (e.g. an HTML error/login page).
#: addon\globalPlugins\freeradio\getem.py:1267
#, python-format
msgid "GETEM did not return audio for this part: %s"
msgstr "O GETEM não devolveu áudio para esta parte: %s"

#. Translators: Same failure as the message above (no valid audio came back for this part), used when there is no response snippet available to show.
#: addon\globalPlugins\freeradio\getem.py:1269
msgid "GETEM did not return a playable audio file for this part."
msgstr ""
"O GETEM não devolveu um ficheiro de áudio reproduzível para esta parte."

#. Translators: Fallback download folder name used when saving a book, if the book's title is empty or has no usable characters.
#. Translators: Fallback folder name used when saving a downloaded book, if the book's title is empty or has no usable characters.
#: addon\globalPlugins\freeradio\getem.py:1518
#: addon\globalPlugins\freeradio\gutenberg_audiobooks.py:611
#: addon\globalPlugins\freeradio\librivox.py:538
#: addon\globalPlugins\freeradio\librivox.py:636
#: addon\globalPlugins\freeradio\podcast.py:439
#: addon\globalPlugins\freeradio\podcast.py:489
msgid "Untitled"
msgstr "Sem título"

#. Shown as this book's narrator (see GutenbergAudiobook.__init__) instead
#. of leaving the field blank the way LibriVox does (which credits a
#. different human reader per chapter) - every book in this collection
#. shares the same kind of narration, so one fixed, honest label is more
#. useful here than an empty field.
#. Translators: Fixed narrator label shown for every book in this AI-narrated collection, in place of a per-book human reader's name.
#: addon\globalPlugins\freeradio\gutenberg_audiobooks.py:131
msgid "AI-generated narration (Microsoft neural text-to-speech)"
msgstr "Narração gerada por IA (síntese neural de voz da Microsoft)"

#: addon\globalPlugins\freeradio\gutenberg_audiobooks.py:207
#, python-format
msgid "AI narration, %s"
msgstr "Narração IA, %s"

#: addon\globalPlugins\freeradio\gutenberg_audiobooks.py:209
msgid "AI narration"
msgstr "Narração IA"

#. Translators: %s = the specific AI voice name, e.g. "SteffanNeural"
#: addon\globalPlugins\freeradio\gutenberg_audiobooks.py:292
#, python-format
msgid "AI-generated narration (Microsoft neural text-to-speech, %s voice)"
msgstr "Narração gerada por IA (síntese neural de voz da Microsoft, voz %s)"

#. Translators: shown as this book's source in the station-details
#. dialog and the Audio Books tab - kept distinct from bare
#. "LibriVox"/"GETEM" (see RadioDialog._audiobook_source_label_for())
#. since this collection is machine-narrated rather than a
#. volunteer-read or library-hosted human-narrated catalog.
#: addon\globalPlugins\freeradio\gutenberg_audiobooks.py:346
msgid "Project Gutenberg (AI narration)"
msgstr "Projeto Gutenberg (narração IA)"

#. Translators: Error returned by resolve_media() when the book has no linked archive.org item id, so no audio files can be looked up.
#: addon\globalPlugins\freeradio\gutenberg_audiobooks.py:393
msgid "This book has no archive.org item to read audio files from."
msgstr ""
"Este livro não tem um item no archive.org de onde ler ficheiros de áudio."

#. Translators: Error returned by get_book_by_url() when the pasted URL doesn't match archive.org's book-details link pattern.
#: addon\globalPlugins\freeradio\gutenberg_audiobooks.py:416
#: addon\globalPlugins\freeradio\librivox.py:405
msgid "This doesn't look like an archive.org book link."
msgstr "Isto não parece ser uma ligação para um livro do archive.org."

#. Translators: Error returned when the archive.org identifier from a pasted link does not resolve to any item at all.
