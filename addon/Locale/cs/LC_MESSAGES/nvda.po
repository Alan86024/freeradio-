msgstr "Zastavit přehrávání FreeRadio"

#. Translators: Line in the stop-confirmation dialog listing an in-progress, immediately-started recording that will be cut off; %s is the station name.
#: addon\globalPlugins\freeradio\playbackCoreMixin.py:160
#: addon\globalPlugins\freeradio\trackInfoMixin.py:570
#, python-format
msgid "Instant recording: %s"
msgstr "Okamžité nahrávání: %s"

#. Translators: Line in the stop-confirmation dialog listing an active scheduled recording that will be cut off; %s is the station name.
#: addon\globalPlugins\freeradio\playbackCoreMixin.py:163
#: addon\globalPlugins\freeradio\trackInfoMixin.py:184
#: addon\globalPlugins\freeradio\trackInfoMixin.py:218
#: addon\globalPlugins\freeradio\trackInfoMixin.py:465
#: addon\globalPlugins\freeradio\trackInfoMixin.py:490
#: addon\globalPlugins\freeradio\trackInfoMixin.py:572
#, python-format
msgid "Scheduled recording: %s"
msgstr "Naplánované nahrávání: %s"

#: addon\globalPlugins\freeradio\playbackCoreMixin.py:167
#: addon\globalPlugins\freeradio\trackInfoMixin.py:575
#, python-format
msgid ""
"The following recordings are active and will be stopped:\n"
"%s\n"
"\n"
"Stop radio and end all recordings?"
msgstr ""
"Následující nahrávky jsou aktivní a budou zastaveny:\n"
"%s\n"
"\n"
"Zastavit rádio a ukončit všechny nahrávky?"

#. Translators: Title of the confirmation dialog shown when stopping playback would cut off active recordings.
#: addon\globalPlugins\freeradio\playbackCoreMixin.py:175
#: addon\globalPlugins\freeradio\trackInfoMixin.py:582
