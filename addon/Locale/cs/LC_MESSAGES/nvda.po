msgstr "Aktivní nahrávky"

#. Translators: Spoken after confirming the stop when active recordings were involved.
#. Translators: Spoken when the stop command is used and there were no active recordings to confirm about.
#: addon\globalPlugins\freeradio\playbackCoreMixin.py:189
#: addon\globalPlugins\freeradio\playbackCoreMixin.py:201
#: addon\globalPlugins\freeradio\trackInfoMixin.py:595
#: addon\globalPlugins\freeradio\trackInfoMixin.py:607
#, fuzzy
msgid "Freeradio stopped"
msgstr "Rádio zastaveno"

#. Translators: Name of an NVDA command; skips to the next station in the favourites list.
#: addon\globalPlugins\freeradio\playbackCoreMixin.py:205
