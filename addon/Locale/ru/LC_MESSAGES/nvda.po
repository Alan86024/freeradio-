#. Translators: Name of an NVDA command in the Input Gestures dialog; opens a list to pick FreeRadio's main audio output device.
#: addon\globalPlugins\freeradio\audioDeviceMixin.py:30
msgid "Select the main FreeRadio output device"
msgstr "Выберите основное устройство вывода FreeRadio"

#: addon\globalPlugins\freeradio\audioDeviceMixin.py:31
#: addon\globalPlugins\freeradio\audioDeviceMixin.py:166
