msgstr "Подкаст"

#. Translators: Field-name row header for the resolved episode audio URL.
#: addon\globalPlugins\freeradio\trackInfoMixin.py:852
msgid "Episode URL"
msgstr "URL эпизода"

#. Translators: Field-name row header for a local jukebox file; value is the track title/filename.
#: addon\globalPlugins\freeradio\trackInfoMixin.py:870
msgid "Track"
msgstr "Трек"

#. Translators: Field-name row header for the track's full file path.
#: addon\globalPlugins\freeradio\trackInfoMixin.py:875
msgid "File"
msgstr "Файл"

#. Translators: Field-name row header for the track's file size.
#: addon\globalPlugins\freeradio\trackInfoMixin.py:880
msgid "Size"
msgstr "Размер"

#. Translators: Field-name row header for the track's duration.
#: addon\globalPlugins\freeradio\trackInfoMixin.py:885
msgid "Duration"
msgstr "Продолжительность"

#: addon\globalPlugins\freeradio\trackInfoMixin.py:895
#, python-format
