#: addon\globalPlugins\freeradio\trackInfoMixin.py:381
#: addon\globalPlugins\freeradio\trackInfoMixin.py:580
msgid "No track metadata found. Starting music recognition…"
msgstr "Метаданные трека не найдены. Запуск распознавания музыки…"

