#: addon\globalPlugins\freeradio\trackInfoMixin.py:900
msgid "Sample rate"
msgstr "Частота дискретизации"

#: addon\globalPlugins\freeradio\trackInfoMixin.py:900
#, python-format
msgid "%.1f kHz"
msgstr "%.1f кГц"

