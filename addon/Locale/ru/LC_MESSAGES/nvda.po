#: addon\globalPlugins\freeradio\trackInfoMixin.py:979
msgid "Book link"
msgstr "Ссылка на книгу"

#. Translators: Spoken after the triple-press/F2/gesture actions copy the current ICY track title to the clipboard; %s is the copied text.
#: addon\globalPlugins\freeradio\trackInfoMixin.py:1143
#, python-format
msgid "Copied: %s"
msgstr "Скопировано: %s"

#. Translators: Spoken if the system clipboard can't be opened for the copy.
#: addon\globalPlugins\freeradio\trackInfoMixin.py:1146
msgid "Could not access clipboard"
msgstr "Не удалось получить доступ к буферу обмена"

#. Translators: Spoken instead of saving a duplicate when the copied track is already in likedSongs.txt; %s is the track text.
#: addon\globalPlugins\freeradio\trackInfoMixin.py:1164
#, python-format
msgid "Already in liked songs: %s"
msgstr "Уже в понравившихся треках: %s"

#: addon\globalPlugins\freeradio\trackInfoMixin.py:1193
#: addon\globalPlugins\freeradio\trackInfoMixin.py:1220
#, python-format
msgid "Song recording saved: %s"
msgstr "Запись песни сохранена: %s"

#. Translators: Spoken automatically while a live recording is in progress if the time-shift disk-space limit is reached and old buffered audio is being discarded faster than usual.
#: addon\globalPlugins\freeradio\__init__.py:416
msgid ""
"Time-shift buffer: running low on disk space, the oldest audio is being "
"dropped more aggressively."
msgstr ""
"Буфер тайм-шифта: заканчивается свободное место на диске, самый старый аудио-"
"материал удаляется более агрессивно."

#. Translators: Spoken when a recording finishes normally; %s is the saved output filename.
#: addon\globalPlugins\freeradio\__init__.py:506
#, python-format
msgid "Recording finished: %s"
msgstr "Запись завершена: %s"

#. Translators: Spoken when a recording never actually started because the stream connection failed for its whole scheduled window; %s is the station name.
#: addon\globalPlugins\freeradio\__init__.py:511
#, python-format
msgid "Recording failed: could not connect to %s"
msgstr "Ошибка записи: не удалось подключиться к %s"

#. Translators: Spoken when converting a finished recording to the configured format (e.g. MP3) fails; the original, unconverted file is kept. %s is its filename.
#: addon\globalPlugins\freeradio\__init__.py:516
#, python-format
msgid "Recording conversion failed. The original file was kept: %s"
msgstr "Ошибка преобразования записи. Исходный файл сохранен: %s"

#. Translators: Spoken when the folder configured for recordings can't be used (e.g. missing/no permission) and FreeRadio saved to its default folder instead; %(station)s is the station name, %(reason)s is why the folder failed.
#: addon\globalPlugins\freeradio\__init__.py:522
#, python-format
msgid ""
"Could not use the selected folder for '%(station)s' (%(reason)s). Saved to "
"the default recordings folder instead."
msgstr ""
"Не удалось использовать выбранную папку для '%(station)s' (%(reason)s). "
"Запись сохранена в папку записей по умолчанию."

#. ── 2. Create / refresh a script for every favourite ─────────────────
#. Translators: Script category shown in NVDA's Input Gestures dialog, grouping the auto-generated 'play this favourite station' shortcuts separately from FreeRadio's main commands.
#: addon\globalPlugins\freeradio\__init__.py:596
msgid "FreeRadio Stations"
msgstr "Станции FreeRadio"

#. Translators: Spoken if a per-favourite-station shortcut is triggered after that station was removed from favourites since the shortcut was created; %s is the station name.
#: addon\globalPlugins\freeradio\__init__.py:617
#, python-format
msgid "Station no longer in favourites: %s"
msgstr "Станция больше не в избранном: %s"

#. NVDA reads __doc__ as the script description and
#. __name__ as the script identifier.
#. Translators: Auto-generated description of a per-favourite-station shortcut, shown in NVDA's Input Gestures dialog; %s is the station name.
#: addon\globalPlugins\freeradio\__init__.py:627
#, python-format
msgid "%s playback shortcut ()"
msgstr "Горячая клавиша воспроизведения %s ()"

#. Translators: Menu item that opens the FreeRadio station browser dialog
#: addon\globalPlugins\freeradio\__init__.py:657
msgid "Station &Browser...\tCtrl+Win+R"
msgstr "&Обозреватель станций...\tCtrl+Win+R"

#. Translators: Menu item that opens FreeRadio settings in NVDA preferences
#: addon\globalPlugins\freeradio\__init__.py:666
msgid "FreeRadio &Settings..."
msgstr "&Настройки FreeRadio..."

#. Translators: Menu item that manually triggers the update check
#: addon\globalPlugins\freeradio\__init__.py:675
msgid "Check for &Updates..."
msgstr "Проверить &обновления..."

#. Translators: Label of the FreeRadio submenu in NVDA Tools menu
#: addon\globalPlugins\freeradio\__init__.py:688
msgid "&FreeRadio"
msgstr "&FreeRadio"

#. Translators: Name of an NVDA command; opens the FreeRadio station browser dialog on its main Stations tab.
#: addon\globalPlugins\freeradio\__init__.py:749
msgid "Open FreeRadio station browser"
msgstr "Открыть обозреватель станций FreeRadio"

#. Translators: Name of an NVDA command; opens the station browser dialog on the Audio Books tab.
#: addon\globalPlugins\freeradio\__init__.py:759
msgid "Open FreeRadio audio book library"
msgstr "Открыть библиотеку аудиокниг FreeRadio"

#. Translators: Name of an NVDA command; opens the station browser dialog on the Podcasts tab.
#: addon\globalPlugins\freeradio\__init__.py:769
msgid "Open FreeRadio podcast subscriptions"
msgstr "Открыть подписки на подкасты FreeRadio"

#. Translators: Name of an NVDA command; opens the station browser dialog on the local Jukebox tab.
#: addon\globalPlugins\freeradio\__init__.py:779
msgid "Open FreeRadio local jukebox"
msgstr "Открыть локальный музыкальный автомат FreeRadio"

#. Translators: Name of an NVDA command whose behaviour depends on what is currently playing: adds a live station to favourites, or downloads the current audio book/podcast episode.
#: addon\globalPlugins\freeradio\__init__.py:789
msgid ""
"Add currently playing station to favourites, download the whole audio book "
"if one is playing, or download the episode if a podcast is playing"
msgstr ""
"Добавить текущую станцию в избранное, загрузить целую аудиокнигу, если она "
"воспроизводится, или загрузить эпизод, если воспроизводится подкаст"

#. Translators: Spoken when this shortcut is pressed while something is playing that is neither a station, podcast episode, nor audio book (e.g. a local jukebox track).
#: addon\globalPlugins\freeradio\__init__.py:809
msgid "The shortcut is only for stations, podcasts or audio books"
msgstr ""
"Горячая клавиша предназначена только для станций, подкастов или аудиокниг"

#. Translators: Spoken when the currently playing station is already saved in favourites; %s is the station name.
#: addon\globalPlugins\freeradio\__init__.py:831
#, python-format
msgid "Already in favourites: %s"
msgstr "Уже в избранном: %s"

#. Translators: Spoken after successfully adding the currently playing station to favourites; %s is the station name.
#: addon\globalPlugins\freeradio\__init__.py:835
#, python-format
msgid "Added to favourites: %s"
msgstr "Добавлено в избранное: %s"

#. Translators: Spoken when this shortcut is pressed to download an audio book but no audio book (GETEM/Gutenberg/LibriVox) is currently playing.
#: addon\globalPlugins\freeradio\__init__.py:850
msgid "No audio book is playing"
msgstr "Ни одна аудиокнига не воспроизводится"

#. Translators: Spoken when downloading the currently playing audio book fails.
#: addon\globalPlugins\freeradio\__init__.py:857
msgid "Could not download this audio book."
msgstr "Не удалось загрузить эту аудиокнигу."

#. Translators: Spoken when a station's connection attempt fails outright, so the user isn't left thinking it's silently playing; %(name)s is the station name, %(reason)s is a short failure description.
#: addon\globalPlugins\freeradio\__init__.py:940
#, python-format
msgid "Could not play %(name)s: %(reason)s"
msgstr "Не удалось воспроизвести %(name)s: %(reason)s"

#. Translators: Spoken during a manual update check when the GitHub repository has no published releases yet.
#: addon\globalPlugins\freeradio\__init__.py:1129
msgid "No releases found on GitHub yet."
msgstr "Релизов на GitHub пока не найдено."

#. Translators: Spoken during a manual update check when the GitHub API request itself returns an HTTP error; %d is the HTTP status code.
#: addon\globalPlugins\freeradio\__init__.py:1134
#, python-format
msgid "Update check failed (HTTP %d)."
msgstr "Проверка обновлений не удалась (HTTP %d)."

#. Translators: Spoken during a manual update check when the request to GitHub fails outright (e.g. no internet connection).
#: addon\globalPlugins\freeradio\__init__.py:1140
msgid "Update check failed. Please check your internet connection."
msgstr "Проверка обновлений не удалась. Проверьте подключение к интернету."

#. Translators: Spoken during a manual update check when GitHub's release data doesn't include a usable version tag.
#: addon\globalPlugins\freeradio\__init__.py:1156
msgid "Could not determine latest version."
msgstr "Не удалось определить последнюю версию."

#. Translators: Update dialog message when direct install is available. %(new)s=new version, %(current)s=current version
#: addon\globalPlugins\freeradio\__init__.py:1175
#, python-format
msgid ""
"A new version of FreeRadio is available: %(new)s.\n"
"You have version %(current)s.\n"
"\n"
"Would you like to download and install it now?"
msgstr ""
"Доступна новая версия FreeRadio: %(new)s.\n"
"У вас установлена версия %(current)s.\n"
"\n"
"Загрузить и установить её сейчас?"

#: addon\globalPlugins\freeradio\__init__.py:1178
#: addon\globalPlugins\freeradio\__init__.py:1187
#: addon\globalPlugins\freeradio\__init__.py:1255
msgid "unknown"
msgstr "неизвестно"

#. Translators: Button label on the update-available dialog when a direct .nvda-addon download is available, offering to install it right away.
#: addon\globalPlugins\freeradio\__init__.py:1180
msgid "&Install"
msgstr "&Установить"

#. Translators: Update dialog message when only a download page is available. %(new)s=new version, %(current)s=current version
#: addon\globalPlugins\freeradio\__init__.py:1184
#, python-format
msgid ""
"A new version of FreeRadio is available: %(new)s.\n"
"You have version %(current)s.\n"
"\n"
"Would you like to open the download page?"
msgstr ""
"Доступна новая версия FreeRadio: %(new)s.\n"
"У вас установлена версия %(current)s.\n"
"\n"
"Открыть страницу загрузки?"

#. Translators: Button label on the update-available dialog when only a release web page (no direct download) is available, offering to open it in a browser.
