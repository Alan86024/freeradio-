msgid "FreeRadio &Settings..."
msgstr "FreeRadio & ការកំណត់..."

#: addon/globalPlugins/freeradio/__init__.py:666
msgid "Check for &Updates..."
msgstr "ពិនិត្យរកមើល &ការធ្វើបច្ចុប្បន្នភាព..."

