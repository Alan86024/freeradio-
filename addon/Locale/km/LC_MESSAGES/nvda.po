#: addon\globalPlugins\freeradio\audioDeviceMixin.py:30
msgid "Select the main FreeRadio output device"
msgstr "ជ្រើសរើសឧបករណ៍បញ្ចេញសំឡេងសំខាន់របស់ FreeRadio"

#: addon\globalPlugins\freeradio\audioDeviceMixin.py:31
