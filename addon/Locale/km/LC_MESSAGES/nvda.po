msgstr "ទំហំ"

#: addon\globalPlugins\freeradio\trackInfoMixin.py:809
msgid "Duration"
msgstr "រយៈពេល"

#: addon\globalPlugins\freeradio\trackInfoMixin.py:817
#, python-format
msgid "%d kbps"
msgstr "%d kbps"

#: addon\globalPlugins\freeradio\trackInfoMixin.py:821
