#, python-format
msgid "Import complete: %(count)d new station added."
msgid_plural "Import complete: %(count)d new stations added."
msgstr[0] "ការនាំចូលបានបញ្ចប់: បានបន្ថែម %(count)d ស្ថានីយ៍ថ្មី។"

#: addon\globalPlugins\freeradio\radioDialog.py:2997
#, python-format
