#: addon/globalPlugins/freeradio/__init__.py:415
msgid "Time-shift buffer: running low on disk space, the oldest audio is being dropped more aggressively."
msgstr "តំបន់ផ្ទុកបណ្ដោះអាសន្នសម្រាប់ប្ដូរពេលវេលា៖ ទំហំថាសជិតអស់ហើយ សំឡេងចាស់ជាងគេកំពុងត្រូវបានលុបចេញយ៉ាងខ្លាំងក្លា។"

#: addon/globalPlugins/freeradio/__init__.py:500 addon/globalPlugins/freeradio/recordingMixin.py:210
#, python-format
msgid "Recording started: %s"
msgstr "ដំណើរការថតបានចាប់ផ្ដើមហើយ: %s"

#: addon/globalPlugins/freeradio/__init__.py:503
#, python-format
msgid "Recording finished: %s"
msgstr "ដំណើរការថតបានបញ្ចប់ហើយ: %s"

#: addon/globalPlugins/freeradio/__init__.py:507
#, python-format
msgid "Recording failed: could not connect to %s"
msgstr "ការថតបានបរាជ័យ៖ មិនអាចភ្ជាប់ទៅ %s បានទេ"

#: addon/globalPlugins/freeradio/__init__.py:511
#, python-format
msgid "Recording conversion failed. The original file was kept: %s"
msgstr "ការបំប្លែងការថតបានបរាជ័យ។ ឯកសារដើមត្រូវបានរក្សាទុក៖ %s"

#: addon/globalPlugins/freeradio/__init__.py:516
#, python-format
msgid ""
"Could not use the selected folder for '%(station)s' (%(reason)s). Saved to the default recordings folder "
"instead."
msgstr "មិនអាចប្រើថតដែលបានជ្រើសរើសសម្រាប់ '%(station)s' (%(reason)s) បានទេ។ បានរក្សាទុកទៅក្នុងថតលំនាំដើមវិញ។"

#: addon/globalPlugins/freeradio/__init__.py:589
msgid "FreeRadio Stations"
msgstr "ស្ថានីយ៍ FreeRadio"

#: addon/globalPlugins/freeradio/__init__.py:609
#, python-format
msgid "Station no longer in favourites: %s"
msgstr "ស្ថានីយ៍លែងនៅក្នុងបញ្ជីចូលចិត្តទៀតហើយ: %s"

#: addon/globalPlugins/freeradio/__init__.py:618
#, python-format
msgid "%s playback shortcut ()"
msgstr "ផ្លូវកាត់សម្រាប់ចាក់ %s ()"

